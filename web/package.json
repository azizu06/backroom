    "@simplewebauthn/browser": "^14.0.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "spacetimedb": "2.13.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "20.19.39",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "jsqr": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
