# Names only. Copy to .env and fill in locally. Never commit real values.
# Team sponsor keys are in /srv/team/backroom.env on the GX10; see AGENTS.md.
# LLM (OpenRouter by default, server-side only)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
# Voice
CARTESIA_API_KEY=
# Local voice relay; generate separate random secrets. Never use client-side.
CARTESIA_WEBHOOK_SECRET=
VOICE_TOOL_SECRET=
VOICE_ADMIN_SECRET=
VOICE_PUBLIC_URL=
VOICE_PORT=8788
# Explicit live-call opt-in; leave unset until fresh authorization.
VOICE_DIAL_GO=
VOICE_WS_GO=
DEMO_OVERRIDE=false
# T1 private destination/consent (never put a real number in this file).
T1_DIAL_TO=
T1_DIAL_GO=
T1_B2B_TEST=
T1_CONSENT_SOURCE=
T1_CONSENT_TEXT=
T1_CONSENT_AT=
T1_PUBLIC_URL=
T1_PORT=8787
# Integrations
CRS_USERNAME=
CRS_PASSWORD=
# Opt-in sandbox probe; trusted local module with sponsor-approved adapters and test identities
CRS_LIVE=
CRS_SANDBOX_MODULE=
CRS_TEST_ID=
NESSIE_API_KEY=
# Server payment page: pre-seeded sandbox account; shared durable claim directory
NESSIE_ACCOUNT_ID=
NESSIE_CLAIMS_DIR=
# Offline page rehearsal only: /pay/payment-demo-1042, no real bank/network
BACKROOM_PAYMENT_DEMO=0
APIFY_TOKEN=
# State
SPACETIMEDB_URI=
SPACETIMEDB_DATABASE=
SPACETIMEDB_TOKEN=
# Shared GX10 Ollama (OpenAI-compatible, over Tailscale; not in the demo critical path)
GX10_BASE_URL=http://100.117.44.20:11434/v1
# Bearer secret the Cartesia agent sends to the tool gateway
TOOL_GATEWAY_SECRET=
# Model router overrides (server-side only; see orchestrator/README.md)
GX10_MODEL=gpt-oss:20b
GX10_ENABLED=true
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Controller passkeys (server-only; HTTPS origin in deployment, localhost for development)
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
CONTROLLER_ENROLLMENT_SECRET=
# Optional local synthetic call fixture; never dials or touches a bank
BACKROOM_APPROVAL_DEMO=0

# Read-only SpacetimeDB browser subscription (optional; local T8 defaults)
NEXT_PUBLIC_SPACETIME_URI=
NEXT_PUBLIC_SPACETIME_DATABASE=

# Optional catalog voice override for ask-why TTS (server only); uses WEBAUTHN_ORIGIN.
CARTESIA_WHY_VOICE_ID=

# Owner policy editor rehearsal fallback; private, >=8 characters, distinct from tool/voice keys
POLICY_DEMO_PIN=
# Exact browser origin; defaults to WEBAUTHN_ORIGIN when unset
POLICY_EDITOR_ORIGIN=
