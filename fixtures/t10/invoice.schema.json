{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "vendor": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "invoiceId": {
      "type": "string"
    },
    "purchaseOrder": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD"
      ]
    },
    "issuedDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dueDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "subtotal": {
      "type": "number",
      "minimum": 0
    },
    "tax": {
      "type": "number",
      "minimum": 0
    },
    "total": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "vendor",
    "customer",
    "invoiceId",
    "purchaseOrder",
    "currency",
    "issuedDate",
    "dueDate",
    "subtotal",
    "tax",
    "total"
  ],
  "additionalProperties": false
}