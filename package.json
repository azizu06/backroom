{
  "name": "backroom",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:web": "pnpm --filter @backroom/web dev",
    "demo:core": "pnpm --filter @backroom/orchestrator exec tsx src/core-demo/cli.ts",
    "eval:run": "pnpm --filter @backroom/orchestrator exec tsx src/eval/cli.ts",
    "state:live": "pnpm --filter @backroom/spacetime test:live",
    "state:seed": "pnpm --filter @backroom/orchestrator exec tsx ../spacetime/scripts/seed.ts",
    "metrics": "pnpm --filter @backroom/orchestrator exec tsx src/metrics/cli.ts",
    "demo:parity": "pnpm --filter @backroom/orchestrator exec tsx ../web/scripts/parity.ts",
    "demo:up": "pnpm --filter @backroom/orchestrator exec tsx ../tools/demo/cli.ts up",
    "demo:reset": "pnpm --filter @backroom/orchestrator exec tsx ../tools/demo/cli.ts reset",
    "demo:down": "pnpm --filter @backroom/orchestrator exec tsx ../tools/demo/cli.ts down",
    "demo:health": "pnpm --filter @backroom/orchestrator exec tsx ../tools/demo/cli.ts health",
    "metrics": "pnpm --filter @backroom/orchestrator exec tsx src/metrics/cli.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
